rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ──────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Reads the calling user's own doc to check tier — safe, no recursion
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(uid())).data.get('tier', '') == 'admin';
    }

    function isMember(shopId) {
      return signedIn()
        && exists(/databases/$(database)/documents/shops/$(shopId)/members/$(uid()));
    }

    function shopMemberRole(shopId) {
      return get(/databases/$(database)/documents/shops/$(shopId)/members/$(uid())).data.get('role', '');
    }

    function isOwnerOrManager(shopId) {
      return isMember(shopId) && shopMemberRole(shopId) in ['owner', 'manager'];
    }

    // ─── Users ────────────────────────────────────────────────────────────
    // Users may only read/write their own document.
    // Admin reads happen server-side via the Admin SDK (bypasses these rules).
    match /users/{userId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    // ─── Vehicles (public catalog) ────────────────────────────────────────
    match /vehicles/{vehicleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Patterns (public catalog) ────────────────────────────────────────
    match /patterns/{patternId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Pattern requests ─────────────────────────────────────────────────
    match /requests/{requestId} {
      allow read:          if true;          // public — shows vote counts
      allow create:        if signedIn();
      allow update, delete: if isAdmin();
    }

    // ─── User patterns ────────────────────────────────────────────────────
    // Each user can create and read their own patterns immediately.
    // isPublished is set only by admins — owners cannot self-approve.
    // Publicly visible once isPublished == true (community-approved).
    match /userPatterns/{patternId} {
      allow read:   if resource.data.ownerId == uid() || resource.data.isPublished == true;
      allow create: if signedIn()
                     && request.resource.data.ownerId == uid()
                     && request.resource.data.isPublished == false;
      allow update: if (resource.data.ownerId == uid()
                        && request.resource.data.isPublished == resource.data.isPublished)
                     || isAdmin();
      allow delete: if resource.data.ownerId == uid() || isAdmin();
    }

    // ─── Pattern adjustment requests ──────────────────────────────────────
    // Users request changes to approved community patterns; admin reviews.
    match /patternAdjustments/{adjId} {
      allow create: if signedIn() && request.resource.data.requestedBy == uid();
      allow read, update, delete: if isAdmin();
    }

    // ─── Cut jobs ─────────────────────────────────────────────────────────
    match /jobs/{jobId} {
      allow read:   if signedIn() && (resource.data.userId == uid() || isAdmin());
      allow create: if signedIn() && request.resource.data.userId == uid();
      allow update: if signedIn() && resource.data.userId == uid();
      allow delete: if signedIn() && (resource.data.userId == uid() || isAdmin());
    }

    // ─── Stats ────────────────────────────────────────────────────────────
    // Computed and written server-side via Admin SDK only; deny all client access.
    match /stats/{statId} {
      allow read, write: if false;
    }

    // ─── Plotters ─────────────────────────────────────────────────────────
    match /plotters/{plotterId} {
      allow read:          if signedIn() && resource.data.userId == uid();
      allow create:        if signedIn() && request.resource.data.userId == uid();
      allow update, delete: if signedIn() && resource.data.userId == uid();
    }

    // ─── Insights (blog posts) ────────────────────────────────────────────
    // Anyone can read published posts; only admins can read drafts or write.
    match /insights/{postId} {
      allow read:          if resource.data.get('status', '') == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ─── Plotter error reports ────────────────────────────────────────────
    // Any signed-in user can report an error; only admins can read and resolve.
    match /plotterErrors/{reportId} {
      allow create:        if signedIn();
      allow read, update, delete: if isAdmin();
    }

    function isOrgMember(orgId) {
      return signedIn()
        && exists(/databases/$(database)/documents/orgs/$(orgId)/members/$(uid()));
    }

    // ─── Organizations ────────────────────────────────────────────────────
    // create is bootstrap-only (self-creation as owner of your own new org
    // — not an escalation vector). update/delete are closed outright: that's
    // where role/team-grant rewriting would happen, and it moves to Admin
    // SDK server routes in Phase 2. Same shape as the existing shops rules.
    match /orgs/{orgId} {
      allow read:   if isOrgMember(orgId);
      allow create: if signedIn();
      allow update, delete: if false;

      match /members/{memberId} {
        allow read:   if isOrgMember(orgId);
        // Self-bootstrap as owner only — creating any other role for
        // yourself, or any member doc for someone else, is denied.
        allow create: if signedIn()
                       && request.resource.data.uid == uid()
                       && request.resource.data.role == 'owner';
        allow update, delete: if false;
      }
    }

    // ─── Shops ────────────────────────────────────────────────────────────
    match /shops/{shopId} {
      allow read:   if isMember(shopId);
      allow create: if signedIn();           // owner creates shop on setup
      allow update: if isOwnerOrManager(shopId);
      allow delete: if false;               // Admin SDK only

      match /members/{memberId} {
        allow read: if isMember(shopId);
        // Bootstrap case: a brand-new shop has no members yet, so
        // isOwnerOrManager can never be true for its first write — permit
        // self-creation as owner; every other create/update/delete still
        // requires existing owner/manager membership.
        allow create: if isOwnerOrManager(shopId)
                       || (signedIn()
                           && request.resource.data.uid == uid()
                           && request.resource.data.role == 'owner');
        allow update, delete: if isOwnerOrManager(shopId);
      }
    }

    // ─── Shop invites ─────────────────────────────────────────────────────
    // Invites are accessed via a secret token URL — anyone with the link can read.
    match /shopInvites/{inviteId} {
      allow read:   if true;
      allow create: if isOwnerOrManager(request.resource.data.shopId);
      allow update: if signedIn();           // any signed-in user can accept
      allow delete: if isOwnerOrManager(resource.data.shopId);
    }
  }
}
