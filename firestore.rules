rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ──────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Reads the calling user's own doc to check tier — safe, no recursion
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(uid())).data.get('tier', '') == 'admin';
    }

    function isMember(shopId) {
      return signedIn()
        && exists(/databases/$(database)/documents/shops/$(shopId)/members/$(uid()));
    }

    // ─── Users ────────────────────────────────────────────────────────────
    // Users may only read/write their own document.
    // Admin reads happen server-side via the Admin SDK (bypasses these rules).
    match /users/{userId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    // ─── Vehicles (public catalog) ────────────────────────────────────────
    match /vehicles/{vehicleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Patterns (public catalog) ────────────────────────────────────────
    match /patterns/{patternId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Pattern requests ─────────────────────────────────────────────────
    match /requests/{requestId} {
      allow read:          if true;          // public — shows vote counts
      allow create:        if signedIn();
      allow update, delete: if isAdmin();
    }

    // ─── User patterns ────────────────────────────────────────────────────
    // Each user can create and read their own patterns immediately.
    // isPublished is set only by admins — owners cannot self-approve.
    // Publicly visible once isPublished == true (community-approved).
    match /userPatterns/{patternId} {
      allow read:   if resource.data.ownerId == uid() || resource.data.isPublished == true;
      allow create: if signedIn()
                     && request.resource.data.ownerId == uid()
                     && request.resource.data.isPublished == false;
      allow update: if (resource.data.ownerId == uid()
                        && request.resource.data.isPublished == resource.data.isPublished)
                     || isAdmin();
      allow delete: if resource.data.ownerId == uid() || isAdmin();
    }

    // ─── Pattern adjustment requests ──────────────────────────────────────
    // Users request changes to approved community patterns; admin reviews.
    match /patternAdjustments/{adjId} {
      allow create: if signedIn() && request.resource.data.requestedBy == uid();
      allow read, update, delete: if isAdmin();
    }

    // ─── Cut jobs ─────────────────────────────────────────────────────────
    match /jobs/{jobId} {
      allow read:   if signedIn() && (resource.data.userId == uid() || isAdmin());
      allow create: if signedIn() && request.resource.data.userId == uid();
      allow update: if signedIn() && resource.data.userId == uid();
      allow delete: if signedIn() && (resource.data.userId == uid() || isAdmin());
    }

    // ─── Stats ────────────────────────────────────────────────────────────
    // Computed and written server-side via Admin SDK only; deny all client access.
    match /stats/{statId} {
      allow read, write: if false;
    }

    // ─── Rate limit counters ──────────────────────────────────────────────
    // Written only via Admin SDK in src/lib/server/rate-limit.ts; deny all client access.
    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    // ─── Server error logs ────────────────────────────────────────────────
    // Written only via Admin SDK in src/lib/server/log-error.ts; read only
    // through src/routes/api/admin/errors (Admin SDK, asserts isAdmin server-side).
    match /errorLogs/{docId} {
      allow read, write: if false;
    }

    // ─── Plotters ─────────────────────────────────────────────────────────
    match /plotters/{plotterId} {
      allow read:          if signedIn() && resource.data.userId == uid();
      allow create:        if signedIn() && request.resource.data.userId == uid();
      allow update, delete: if signedIn() && resource.data.userId == uid();
    }

    // ─── Insights (blog posts) ────────────────────────────────────────────
    // Anyone can read published posts; only admins can read drafts or write.
    match /insights/{postId} {
      allow read:          if resource.data.get('status', '') == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ─── Plotter error reports ────────────────────────────────────────────
    // Any signed-in user can report an error; only admins can read and resolve.
    match /plotterErrors/{reportId} {
      allow create:        if signedIn();
      allow read, update, delete: if isAdmin();
    }

    function isOrgMember(orgId) {
      return signedIn()
        && exists(/databases/$(database)/documents/orgs/$(orgId)/members/$(uid()));
    }

    // A user with an org-wide grant (Phase 3 group, or org-wide OrgMember)
    // can see a shop in the org switcher without being a direct
    // shops/{shopId}/members/{uid} member of it — Phase 5 needs that shop
    // to actually be readable, not just listable via the server route.
    function canReadShop(shopId) {
      return isMember(shopId)
        || (get(/databases/$(database)/documents/shops/$(shopId)).data.get('orgId', null) != null
            && isOrgMember(get(/databases/$(database)/documents/shops/$(shopId)).data.get('orgId', null)));
    }

    // ─── Organizations ────────────────────────────────────────────────────
    // Read-only for clients. All create/update/delete — org, and shop and
    // invite mutations below — go through Admin SDK server routes
    // (src/routes/api/shops/**), which enforce role-escalation caps,
    // last-owner, and seat invariants that rules can't express.
    // isAdmin() is checked directly on each allow line (not folded into
    // isMember/isOrgMember) so a normal member's read stays at its
    // original get()/exists() cost — folding it into the helpers would
    // add an extra get() to every call site, including nested ones
    // (canReadShop calls isOrgMember), and rules only budget 10 document
    // accesses per request.
    match /orgs/{orgId} {
      allow read:  if isAdmin() || isOrgMember(orgId);
      allow write: if false;

      match /members/{memberId} {
        allow read:  if isAdmin() || isOrgMember(orgId);
        allow write: if false;
      }

      // Groups: org-level, scoped grants — src/routes/api/orgs/**. Mutating
      // a group's role/shopIds changes every member's effective permission,
      // which is exactly the kind of chain rules can't safely evaluate.
      match /groups/{groupId} {
        allow read:  if isAdmin() || isOrgMember(orgId);
        allow write: if false;

        match /groupMembers/{memberId} {
          allow read:  if isAdmin() || isOrgMember(orgId);
          allow write: if false;
        }
      }
    }

    // ─── Shops ────────────────────────────────────────────────────────────
    match /shops/{shopId} {
      allow read:  if isAdmin() || canReadShop(shopId);
      allow write: if false;

      match /members/{memberId} {
        allow read:  if isAdmin() || canReadShop(shopId);
        allow write: if false;
      }
    }

    // ─── Shop invites ─────────────────────────────────────────────────────
    // Read stays open: accessed via a secret token URL (the join page reads
    // it pre-auth to render "you've been invited to X"), and the token
    // itself is the capability — write moved server-side.
    match /shopInvites/{inviteId} {
      allow read:  if true;
      allow write: if false;
    }
  }
}
