rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Same admin test as firestore.rules: the caller's users/{uid} doc says tier == 'admin'.
    function isAdmin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('tier', '') == 'admin';
    }

    // Make / model / trim logos and images for the library browser (Admin → Vehicle media).
    // Shown to every visitor; only admins may upload, images up to 5 MB.
    match /vehicle-media/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }
  }
}
