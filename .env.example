# ─────────────────────────────────────────────
# OmniPlot — ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in values
# Never commit .env.local to git
# ─────────────────────────────────────────────

# ─── Firebase (client) ───────────────────────
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Stripe Connect ──────────────────────────
# OmniPlot's connected account ID under the master platform account.
# Found in Stripe Dashboard → Connect → Accounts (or provided by the platform).
STRIPE_CONNECTED_ACCOUNT_ID=acct_your_connected_account_id

# ─── Firebase Admin (server-only) ────────────
# Download from Firebase Console → Project Settings → Service Accounts → Generate new private key
# Paste the entire JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"firebase-adminsdk@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# ─── Stripe ──────────────────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_key_here
STRIPE_SECRET_KEY=sk_live_your_secret_key            # server-only, never prefix with VITE_
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret      # from Stripe Dashboard → Webhooks

# Individual plan price IDs (from Stripe Dashboard → Products)
VITE_STRIPE_LITE_MONTHLY=price_lite_monthly_id
VITE_STRIPE_LITE_YEARLY=price_lite_yearly_id
VITE_STRIPE_PRO_MONTHLY=price_pro_monthly_id
VITE_STRIPE_PRO_YEARLY=price_pro_yearly_id

# Shop/team plan price IDs
VITE_STRIPE_SHOP_STARTER_MONTHLY=price_shop_starter_monthly_id
VITE_STRIPE_SHOP_STARTER_YEARLY=price_shop_starter_yearly_id
VITE_STRIPE_SHOP_TEAM_MONTHLY=price_shop_team_monthly_id
VITE_STRIPE_SHOP_TEAM_YEARLY=price_shop_team_yearly_id
VITE_STRIPE_SHOP_STUDIO_MONTHLY=price_shop_studio_monthly_id
VITE_STRIPE_SHOP_STUDIO_YEARLY=price_shop_studio_yearly_id

# ─── App ─────────────────────────────────────
VITE_APP_URL=https://omniplot.app
VITE_APP_ENV=production   # development | production

# ─── Email (Resend) ──────────────────────────
# Get your API key at resend.com → API Keys
# Verify omniplot.app domain in Resend before going live
RESEND_API_KEY=re_your_api_key_here
