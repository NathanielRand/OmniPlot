# ─────────────────────────────────────────────
# OmniPlot — ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in values
# Never commit .env.local to git
# ─────────────────────────────────────────────

# ─── Firebase ────────────────────────────────
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Stripe ──────────────────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_key_here
STRIPE_SECRET_KEY=sk_live_your_secret_key            # server-only, never prefix with VITE_
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

VITE_STRIPE_LITE_MONTHLY=price_lite_monthly_id
VITE_STRIPE_LITE_YEARLY=price_lite_yearly_id
VITE_STRIPE_PRO_MONTHLY=price_pro_monthly_id
VITE_STRIPE_PRO_YEARLY=price_pro_yearly_id

# ─── App ─────────────────────────────────────
VITE_APP_URL=https://omniplot.app
VITE_APP_ENV=production   # development | production
